  "components": {
    "schemas": {
      "CreateUserBody": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "phoneNumber": {
            "type": "string",
            "pattern": "^09\\d{9}$"
          },
          "password": {
            "type": "string",
            "minLength": 8
          },
          "email": {
            "anyOf": [
              {
                "type": "string",
                "format": "email",
                "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              },
              {
                "type": "string",
                "const": ""
              }
            ]
          },
          "avatar": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "string",
                "const": ""
              }
            ]
          },
          "isEnable": {
            "type": "boolean"
          },
          "nationalCode": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{10}$"
              },
              {
                "type": "string",
                "const": ""
              }
            ]
          },
          "role": {
            "default": "customer",
            "type": "string",
            "enum": [
              "admin",
              "customer",
              "seller"
            ]
          },
          "age": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "orders": {
            "type": "array",
            "items": {}
          },
          "wishlist": {
            "type": "array",
            "items": {}
          }
        },
        "required": [
          "phoneNumber",
          "password",
          "role"
        ],
        "additionalProperties": false
      },
      "UpdateUserPersonalInfoBody": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{24}$"
          },
          "firstName": {
            "type": "string",
            "minLength": 2
          },
          "lastName": {
            "type": "string",
            "minLength": 2
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "nationalCode": {
            "type": "string",
            "pattern": "^\\d{10}$"
          },
          "age": {
            "type": "integer",
            "minimum": 4,
            "maximum": 9007199254740991
          },
          "avatar": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "AddUserAddressBody": {
        "type": "object",
        "properties": {
          "province": {
            "type": "string",
            "minLength": 2
          },
          "city": {
            "type": "string",
            "minLength": 2
          },
          "detailAddress": {
            "type": "string",
            "minLength": 5
          },
          "plate": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "postalCode": {
            "type": "string",
            "pattern": "^\\d{10}$"
          },
          "receiverIsMe": {
            "default": false,
            "type": "boolean"
          },
          "firstName": {
            "type": "string",
            "minLength": 2
          },
          "lastName": {
            "type": "string",
            "minLength": 2
          },
          "nationalCode": {
            "type": "string",
            "pattern": "^\\d{10}$"
          },
          "phoneNumber": {
            "type": "string",
            "pattern": "^09\\d{9}$"
          }
        },
        "required": [
          "province",
          "city",
          "detailAddress",
          "plate",
          "postalCode",
          "receiverIsMe"
        ],
        "additionalProperties": false
      },
      "EditUserAddressBody": {
        "type": "object",
        "properties": {
          "province": {
            "type": "string",
            "minLength": 2
          },
          "city": {
            "type": "string",
            "minLength": 2
          },
          "detailAddress": {
            "type": "string",
            "minLength": 5
          },
          "plate": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "postalCode": {
            "type": "string",
            "pattern": "^\\d{10}$"
          },
          "receiverIsMe": {
            "type": "boolean"
          },
          "firstName": {
            "type": "string",
            "minLength": 2
          },
          "lastName": {
            "type": "string",
            "minLength": 2
          },
          "nationalCode": {
            "type": "string",
            "pattern": "^\\d{10}$"
          },
          "phoneNumber": {
            "type": "string",
            "pattern": "^09\\d{9}$"
          }
        },
        "additionalProperties": false
      },
      "ChangeUserPasswordBody": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "minLength": 8
          },
          "oldPassword": {
            "type": "string",
            "minLength": 8
          },
          "repeatPassword": {
            "type": "string",
            "minLength": 8
          },
          "userId": {
            "type": "string"
          }
        },
        "required": [
          "password",
          "oldPassword",
          "repeatPassword",
          "userId"
        ],
        "additionalProperties": false
      },
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "isSuccess": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string"
          },
          "data": {}
        },
        "required": [
          "isSuccess"
        ]
      },
      "PaginatedResponse": {
        "type": "object",
        "properties": {
          "isSuccess": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "object",
            "properties": {
              "result": {
                "type": "array",
                "items": {}
              },
              "pagination": {
                "type": "object",
                "properties": {
                  "currentPage": {
                    "type": "integer"
                  },
                  "totalPages": {
                    "type": "integer"
                  },
                  "totalItems": {
                    "type": "integer"
                  },
                  "itemsPerPage": {
                    "type": "integer"
                  },
                  "hasNextPage": {
                    "type": "boolean"
                  },
                  "hasPrevPage": {
                    "type": "boolean"
                  },
                  "nextPage": {
                    "type": "integer",
                    "nullable": true
                  },
                  "prevPage": {
                    "type": "integer",
                    "nullable": true
                  }
                }
              }
            }
          }
        },
        "required": [
          "isSuccess"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "isSuccess": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string"
          },
          "data": {}
        },
        "required": [
          "isSuccess"
        ]
      }
    }
  }
