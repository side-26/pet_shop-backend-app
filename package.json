{
  "name": "pet_shop-backend-app",
  "version": "1.0.0",
  "description": "pet_shop backend application with express.js",
  "main": "./src/server.js",
  "scripts": {
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "lint": "eslint . --fix",
    "predev": "npm run format && npm run lint",
    "dev": "cross-env NODE_ENV=development nodemon ./src/server.js",
    "prestart": "npm run format && npm run lint",
    "start": "cross-env NODE_ENV=production node ./src/server.js",
    "prepare": "husky",
    "swagger": "node ./src/configs/swagger.config.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "module-alias": "^2.3.4",
    "mongoose": "^9.6.2",
    "multer": "^2.1.1",
    "nanoid": "^6.0.1",
    "nodemailer": "^9.0.4",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.35.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.7.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "swagger-autogen": "^2.23.7"
  },
  "imports": {
    "#configs/*": "./src/configs/*",
    "#routes/*": "./src/routes/*",
    "#entities/*": "./src/entities/*",
    "#middlewares/*": "./src/middlewares/*",
    "#utils/*": "./src/utils/*"
  }
}
